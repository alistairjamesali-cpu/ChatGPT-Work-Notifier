{
  "manifest_version": 3,
  "name": "ChatGPT Work Notifier",
  "short_name": "Work Notifier",
  "version": "2.4.0",
  "description": "Managed-window ChatGPT work monitoring in your existing Chrome profile with fail-closed completion, timeout/25-minute/stuck-Thinking detection, positive extended-thinking/tool RUNNING signals, persistent manual-action alerts, safe rate-limited recovery, guarded auto-resume, reported and estimated progress, tray controls, and advanced local diagnostics.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:38765/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "managed-bootstrap.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "state-engine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatGPT Work Notifier",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
